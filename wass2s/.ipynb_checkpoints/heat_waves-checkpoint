    def compute_xarray(
        self,
        ds_tx: Union[xr.Dataset, xr.DataArray],
        ds_tn: Optional[Union[xr.Dataset, xr.DataArray]] = None,
        metric: str = "WSDI",
        parallel: bool = True,
        nb_cores: int = 4
    ) -> xr.DataArray:
        """
        Compute heat wave indices for xarray data.
        """
        # Extract TX DataArray
        if isinstance(ds_tx, xr.Dataset):
            da_tx = ds_tx["TMAX"] if "TMAX" in ds_tx else ds_tx[list(ds_tx.data_vars)[0]]
        else:
            da_tx = ds_tx
        
        # 1. Standardize dimension names (e.g., y -> lat, x -> lon)
        da_tx = self._standardize_dims(da_tx)
        
        # Apply seasonal mask
        if self.season:
            da_tx = da_tx.where(da_tx.time.dt.month.isin(self.season), drop=True)
        
        # 2. Dynamic Parallel Chunking
        # FIX: Detect the actual spatial dimension names instead of hardcoding 'y'/'x'
        if parallel:
            # Determine which spatial names are currently in use
            # _standardize_dims prefers 'lat'/'lon', but we check dynamically
            y_dim = 'lat' if 'lat' in da_tx.dims else ('y' if 'y' in da_tx.dims else None)
            x_dim = 'lon' if 'lon' in da_tx.dims else ('x' if 'x' in da_tx.dims else None)

            if y_dim and x_dim:
                # Use .sizes instead of .get_index() to be safe against missing coords
                y_chunk = int(np.round(da_tx.sizes[y_dim] / nb_cores))
                x_chunk = int(np.round(da_tx.sizes[x_dim] / nb_cores))
                
                chunk_size = {y_dim: max(1, y_chunk), x_dim: max(1, x_chunk)}
                da_tx = da_tx.chunk({'time': -1, **chunk_size})
        
        # Select base period
        da_tx_base = da_tx.sel(time=self.base_period)
        
        # Calculate TX thresholds
        windowed_tx = da_tx_base.rolling(time=5, center=True, min_periods=1).construct("window")
        tx_thresholds = windowed_tx.groupby("time.dayofyear").quantile(
            self.tx_percentile / 100.0,
            dim=["time", "window"],
            method='linear',
            skipna=True
        )
        
        # Handle leap days
        doy = da_tx.time.dt.dayofyear
        doy_fixed = xr.where(doy == 366, 365, doy)
        
        full_tx_thresholds = tx_thresholds.sel(dayofyear=doy_fixed).drop_vars("dayofyear")
        full_tx_thresholds = full_tx_thresholds.assign_coords(time=da_tx.time)
        
        # Identify hot days based on TX
        is_hot_tx = (da_tx > full_tx_thresholds).astype(float)
        is_hot_tx = is_hot_tx.where(da_tx.notnull())
        
        # Compound heat waves logic
        if ds_tn is not None and self.require_both_tx_tn:
            if isinstance(ds_tn, xr.Dataset):
                da_tn = ds_tn["TMIN"] if "TMIN" in ds_tn else ds_tn[list(ds_tn.data_vars)[0]]
            else:
                da_tn = ds_tn
            
            da_tn = self._standardize_dims(da_tn) # Standardize dims for TN too
            
            if self.season:
                da_tn = da_tn.where(da_tn.time.dt.month.isin(self.season), drop=True)
            
            da_tn_base = da_tn.sel(time=self.base_period)
            windowed_tn = da_tn_base.rolling(time=5, center=True, min_periods=1).construct("window")
            tn_thresholds = windowed_tn.groupby("time.dayofyear").quantile(
                (self.tn_percentile or 90) / 100.0, dim=["time", "window"], method='linear', skipna=True
            )
            
            full_tn_thresholds = tn_thresholds.sel(dayofyear=doy_fixed).drop_vars("dayofyear")
            full_tn_thresholds = full_tn_thresholds.assign_coords(time=da_tn.time)
            
            is_hot_tn = (da_tn > full_tn_thresholds).astype(float)
            is_hot_tn = is_hot_tn.where(da_tn.notnull())
            is_hot = (is_hot_tx == 1) & (is_hot_tn == 1)
        else:
            is_hot = (is_hot_tx == 1)
        
        # Apply min consecutive days
        rolling_hot = is_hot.rolling(time=self.min_consecutive_days, center=False).sum()
        heat_wave_mask = (rolling_hot >= self.min_consecutive_days)
        heat_wave_extended = heat_wave_mask.copy() # Simplification for logic flow
        
        # Calculate metric
        if metric == "WSDI":
            result = heat_wave_extended.resample(time='YS').sum(dim='time', skipna=True).astype(int)
        elif metric == "HWF":
            heat_wave_start = heat_wave_mask & (~heat_wave_mask.shift(time=1, fill_value=False))
            result = heat_wave_start.resample(time='YS').sum(dim='time', skipna=True).astype(int)
        elif metric == "HWDI":
            # (Keeping your complex HWDI logic as provided)
            def max_consecutive(arr):
                if np.all(np.isnan(arr)): return 0
                arr_bool = arr.astype(bool)
                if not np.any(arr_bool): return 0
                diff = np.diff(np.concatenate(([False], arr_bool, [False])))
                durations = np.where(diff == -1)[0] - np.where(diff == 1)[0]
                return np.max(durations) if len(durations) > 0 else 0
            
            years = np.unique(heat_wave_extended.time.dt.year.values)
            results = []
            for year in years:
                year_data = heat_wave_extended.sel(time=heat_wave_extended.time.dt.year == year)
                max_durations = xr.apply_ufunc(
                    max_consecutive, year_data,
                    input_core_dims=[['time']], output_core_dims=[[]],
                    vectorize=True, dask='parallelized' if parallel else 'allowed'
                )
                max_durations = max_durations.expand_dims(time=[pd.Timestamp(f"{year}-01-01")])
                results.append(max_durations)
            result = xr.concat(results, dim='time')
        else:
            raise ValueError(f"Unknown metric: {metric}")
        
        # Set metadata
        result.name = metric
        result.attrs.update(self._get_metadata(metric))
        
        # 3. Compute and clean up names
        # FIX: Handle renaming carefully. 
        # If standardized to 'lat'/'lon', we want to rename back to 'Y'/'X' usually.
        final = result.compute().drop_vars("quantile", errors="ignore")
        
        rename_map = {"time": "T"}
        if 'lat' in final.dims: rename_map['lat'] = 'Y'
        elif 'y' in final.dims: rename_map['y'] = 'Y'
        
        if 'lon' in final.dims: rename_map['lon'] = 'X'
        elif 'x' in final.dims: rename_map['x'] = 'X'
            
        return final.rename(rename_map)
    
    def _standardize_dims(self, da: xr.DataArray) -> xr.DataArray:
        """Standardize dimension names to lat/lon/time."""
        dim_map = {}
        
        # Identify time dimension
        for tc in ['time', 'T', 'date', 'Date']:
            if tc in da.dims:
                dim_map[tc] = 'time'
                break
        
        # Identify spatial dimensions - Maps TO 'lat' and 'lon'
        spatial_pairs = [
            (['lat', 'y', 'latitude', 'Y'], 'lat'),
            (['lon', 'x', 'longitude', 'X'], 'lon')
        ]
        
        for candidates, std_name in spatial_pairs:
            for cand in candidates:
                if cand in da.dims:
                    dim_map[cand] = std_name
                    break
        
        if dim_map:
            da = da.rename(dim_map)
        
        if 'time' not in da.dims:
            raise ValueError(f"DataArray must have 'time' dimension. Found: {list(da.dims)}")
        
        return da

